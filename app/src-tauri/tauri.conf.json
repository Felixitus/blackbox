{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackbox",
  "version": "0.1.0",
  "identifier": "dev.blackbox.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/fetch-presentmon.mjs && cargo build --release -p blackbox-cli"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blackbox",
        "width": 1200,
        "height": 780,
        "minWidth": 920,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Felix Spiß",
    "copyright": "Copyright (c) 2026 Felix Spiß. All rights reserved.",
    "shortDescription": "Flight recorder for your gaming PC",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/blackbox.exe": "cli/blackbox.exe",
      "vendor/PresentMon.exe": "PresentMon.exe",
      "licenses/PresentMon-LICENSE.txt": "licenses/PresentMon-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Blackbox",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
